# Next.js 서버에서 접근할 Kotlin 서버 주소 (브라우저에 노출하지 않음)
WANTEDHACKER_SERVER_URL=http://127.0.0.1:8080

# Docker Compose overrides (optional). Web containers use http://server:8080.
# SERVER_SOURCE_DIR=../03_wantedhacker-server
# WEB_PORT=3000
# SERVER_PORT=8080
# DEV_PORT=3001
# ES_VERSION=9.4.5

# Optional interview AI. Default: locally generated template questions.
# Keep these server-side; never use NEXT_PUBLIC_ for the key.
INTERVIEW_AI_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_INTERVIEW_MODEL=your-structured-output-capable-model
