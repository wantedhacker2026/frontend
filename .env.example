# Next.js 서버에서 접근할 Kotlin 서버 주소 (브라우저에 노출하지 않음)
WANTEDHACKER_SERVER_URL=http://127.0.0.1:8080

# Docker Compose overrides (optional). Web containers use http://server:8080.
# SERVER_SOURCE_DIR=../03_wantedhacker-server
# WEB_PORT=3000
# SERVER_PORT=8080
# DEV_PORT=3001
# ES_VERSION=9.4.5

# Next.js <-> Kotlin trusted proxy; use the same random value (32+ characters).
# Generate locally: openssl rand -hex 32
INTERVIEW_PROXY_SECRET=
# Authentication uses the backend's email verification API. Demo login is disabled.
# Set true for HTTPS deployment.
SESSION_COOKIE_SECURE=false
# URL import: Docker includes Chromium and enables rendering by default.
# For npm run dev: npx playwright install chromium --only-shell
# Set true only on a Node host with Chromium installed (not a standard serverless function).
# JOB_IMPORT_RENDER_ENABLED=true
# OPENAI_API_KEY belongs only in ../03_wantedhacker-server/.env.
